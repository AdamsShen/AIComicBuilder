# App
DATABASE_URL=file:./data/aicomic.db
UPLOAD_DIR=./uploads

# 试用时长（天），默认 3
TRIAL_DURATION_DAYS=3

# Alipay 支付宝（钱包充值）
# 生产网关: https://openapi.alipay.com/gateway.do  沙箱: https://openapidev.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Stripe 钱包充值
# 前往 https://dashboard.stripe.com/test/apikeys 获取测试密钥（确认右上角"View test data"已开启）
STRIPE_SECRET_KEY=sk_test_xxxxx
# 前端公钥（当前 Checkout Session 模式由服务端主导，此项预留以便后续接入 Stripe Elements）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# Webhook 签名密钥：在 Stripe Dashboard → Developers → Webhooks 创建 endpoint，或通过 stripe CLI 本地监听获取
#   stripe login
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
